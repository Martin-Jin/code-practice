{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure practice tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}\\build",
                "-G",
                "Ninja",
                "-DCMAKE_CXX_COMPILER=C:\\msys64\\mingw64\\bin\\g++.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build practice tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\build"
            ],
            "dependsOn": "Configure practice tests",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
